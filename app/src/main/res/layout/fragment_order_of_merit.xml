<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.oom.OrderOfMeritFragment">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOrderOfMerit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingVertical="@dimen/list_screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:listitem="@layout/item_order_of_merit" />

    <TextView
        android:id="@+id/tvEmptyOom"
        style="@style/Widget.DannyApp.Text.EmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_oom_data_available"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStickyUserTop"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:layout_marginTop="8dp"
        android:visibility="invisible"
        style="@style/Widget.DannyApp.Card.StickyUser"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <include layout="@layout/include_sticky_user_row" />
    </com.google.android.material.card.MaterialCardView>

    <View
        android:id="@+id/shadowStickyTop"
        android:layout_width="0dp"
        android:layout_height="@dimen/sticky_shadow_height"
        android:layout_marginHorizontal="6dp"
        android:background="@drawable/shadow_sticky_top"
        android:elevation="15dp"
        android:visibility="invisible"
        app:layout_constraintTop_toBottomOf="@id/cardStickyUserTop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStickyUserBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        android:layout_marginBottom="8dp"
        android:visibility="invisible"
        style="@style/Widget.DannyApp.Card.StickyUser"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <include layout="@layout/include_sticky_user_row" />
    </com.google.android.material.card.MaterialCardView>

    <View
        android:id="@+id/shadowStickyBottom"
        android:layout_width="0dp"
        android:layout_height="@dimen/sticky_shadow_height"
        android:layout_marginHorizontal="6dp"
        android:background="@drawable/shadow_sticky_bottom"
        android:elevation="15dp"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@id/cardStickyUserBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
