<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/player_item_margin_v"
    android:layout_marginBottom="@dimen/player_item_margin_v"
    tools:layout_marginTop="24dp"
    app:cardCornerRadius="8dp"
    app:strokeWidth="@dimen/card_stroke_thick">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/player_item_padding_h"
        android:paddingEnd="@dimen/player_item_padding_h"
        android:paddingTop="@dimen/player_item_padding_v"
        android:paddingBottom="@dimen/player_item_padding_v">

        <TextView
            android:id="@+id/tvPlayerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="@dimen/player_item_name_size"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="8dp">


            <LinearLayout
                android:id="@+id/layoutTourCards"
                android:layout_width="@dimen/player_item_tourcard_container_width"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvTourCardFirst"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/player_item_tourcard_icon_size"
                    android:text="@string/player_tour_card_icon" />

                <TextView
                    android:id="@+id/tvTourCardSecond"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-13dp"
                    android:layout_marginTop="-3dp"
                    android:textSize="@dimen/player_item_tourcard_icon_size"
                    android:text="@string/player_tour_card_icon" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvPlayerSkill"
                android:layout_width="@dimen/player_item_skill_width"
                android:layout_height="@dimen/player_item_skill_height"
                android:gravity="center"
                android:textSize="@dimen/player_item_skill_text_size"
                android:textStyle="bold"
                android:background="@drawable/bg_skill_badge"
                 />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
