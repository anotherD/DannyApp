<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/seasonSummaryMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.career.SeasonSummaryActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollSeasonSummary"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/btnStartNextSeason"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/summary_padding">

            <TextView
                android:id="@+id/tvSeasonSummaryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/summary_card_spacing"
                android:textSize="@dimen/summary_header_size"
                android:textStyle="bold"
                tools:text="Saison 1 – Zusammenfassung" />

            <!-- Sektion 1: Persönliche Bilanz -->
            <TextView
                android:id="@+id/tvSectionPersonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/summary_row_spacing"
                android:text="@string/season_summary_section_personal"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/summary_section_header_size"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DannyApp.Card.Variant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/summary_card_spacing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/summary_padding">

                    <TextView
                        android:id="@+id/tvSummaryUserPlayer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="@dimen/summary_card_spacing"
                        android:textSize="@dimen/summary_player_size"
                        android:textStyle="bold"
                        tools:text="🇩🇪 Max Mustermann" />

                    <!-- Ranglisten 2x2 Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/summary_row_spacing"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="@dimen/summary_row_spacing">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/oom_tab_oom"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="@dimen/summary_label_size" />

                            <TextView
                                android:id="@+id/tvSummaryOom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/summary_body_size"
                                android:textStyle="bold"
                                tools:text="#1 (£45,000)" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="@dimen/summary_row_spacing">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/oom_tab_pt"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="@dimen/summary_label_size" />

                            <TextView
                                android:id="@+id/tvSummaryPtOom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/summary_body_size"
                                android:textStyle="bold"
                                tools:text="#2 (£20,000)" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/summary_card_spacing"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="@dimen/summary_row_spacing">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/oom_tab_pc"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="@dimen/summary_label_size" />

                            <TextView
                                android:id="@+id/tvSummaryPcOom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/summary_body_size"
                                android:textStyle="bold"
                                tools:text="#3 (£10,000)" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="@dimen/summary_row_spacing">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/oom_tab_et"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="@dimen/summary_label_size" />

                            <TextView
                                android:id="@+id/tvSummaryEtOom"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="@dimen/summary_body_size"
                                android:textStyle="bold"
                                tools:text="#4 (£5,000)" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/summary_row_spacing" />

                    <!-- Match-Bilanz -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/summary_row_spacing"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/season_summary_matches_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/summary_label_size" />

                        <TextView
                            android:id="@+id/tvSummaryMatches"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/summary_body_size"
                            android:textStyle="bold"
                            tools:text="15 Siege • 5 Niederlagen (10 Turniere)" />
                    </LinearLayout>

                    <!-- Bestes Turnierergebnis -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/summary_row_spacing"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/season_summary_best_result_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/summary_label_size" />

                        <TextView
                            android:id="@+id/tvSummaryBestResult"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/summary_body_size"
                            android:textStyle="bold"
                            tools:text="World Championship (Sieger)" />
                    </LinearLayout>

                    <!-- Tour-Card-Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/summary_row_spacing"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/season_summary_tour_card_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/summary_label_size" />

                        <TextView
                            android:id="@+id/tvSummaryTourCard"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/summary_body_size"
                            android:textStyle="bold"
                            tools:text="Tour Card über Top 64 OOM gehalten" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sektion 2: Saison-Highlights -->
            <TextView
                android:id="@+id/tvSectionHighlights"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/summary_row_spacing"
                android:text="@string/season_summary_section_highlights"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/summary_section_header_size"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.DannyApp.Card.Variant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/summary_card_spacing">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/summary_padding">

                    <!-- Weltmeister -->
                    <LinearLayout
                        android:id="@+id/layoutSummaryWorldChampionContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/summary_row_spacing"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/season_summary_world_champion_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/summary_label_size" />

                        <TextView
                            android:id="@+id/tvSummaryWorldChampion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/summary_body_size"
                            android:textStyle="bold"
                            tools:text="🇩🇪 Max Mustermann" />
                    </LinearLayout>

                    <!-- Nr. 1 Order of Merit -->
                    <LinearLayout
                        android:id="@+id/layoutSummaryOomLeaderContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/summary_row_spacing"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/season_summary_oom_leader_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/summary_label_size" />

                        <TextView
                            android:id="@+id/tvSummaryOomLeader"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/summary_body_size"
                            android:textStyle="bold"
                            tools:text="🇳🇱 Michael van Gerwen (£450,000)" />
                    </LinearLayout>

                    <!-- Aufsteiger der Saison -->
                    <LinearLayout
                        android:id="@+id/layoutSummaryTopClimberContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/summary_row_spacing"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/season_summary_top_climber_label"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="@dimen/summary_label_size" />

                        <TextView
                            android:id="@+id/tvSummaryTopClimber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="@dimen/summary_body_size"
                            android:textStyle="bold"
                            tools:text="🏴󠁧󠁢󠁥󠁮󠁧󠁿 Luke Humphries (+15 Plätze, +£50,000)" />
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/summary_row_spacing" />

                    <TextView
                        android:id="@+id/tvSectionMajorWinnersHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/season_summary_major_winners_label"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/summary_body_size"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutMajorWinnersList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/summary_row_spacing" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/season_summary_relegated_label"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="@dimen/summary_body_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSummaryRelegatedNone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/season_summary_relegated_none"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/summary_sub_size"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutRelegatedPlayersList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btnStartNextSeason"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/primary_bottom_button_margin_h"
        android:layout_marginBottom="@dimen/primary_bottom_button_margin_bottom"
        android:minHeight="@dimen/start_button_min_height"
        android:textSize="@dimen/primary_bottom_button_text_size"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Nächste Saison (2) starten" />

    <!-- Lade-/Fortschritts-Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutSeasonSummaryLoadingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tvSeasonSummaryLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Saison wird vorbereitet…" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
