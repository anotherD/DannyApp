<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="8dp"
    android:paddingBottom="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMatch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="12dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <!-- Player 1 -->
            <TextView
                android:id="@+id/tvPlayer1Flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="🏴󠁧󠁢󠁥󠁮󠁧󠁿" />

            <TextView
                android:id="@+id/tvPlayer1Name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvPlayer1Flag"
                app:layout_constraintEnd_toStartOf="@id/tvPlayer1Score"
                app:layout_constraintStart_toEndOf="@id/tvPlayer1Flag"
                app:layout_constraintTop_toTopOf="@id/tvPlayer1Flag"
                tools:text="Luke Humphries" />

            <!-- Score Center -->
            <TextView
                android:id="@+id/tvPlayer1Score"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvScoreDivider"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="6" />

            <TextView
                android:id="@+id/tvScoreDivider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvPlayer2Score"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvScoreDivider"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="4" />

            <!-- Player 2 -->
            <TextView
                android:id="@+id/tvPlayer2Flag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="🇳🇱" />

            <TextView
                android:id="@+id/tvPlayer2Name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvPlayer2Flag"
                app:layout_constraintEnd_toStartOf="@id/tvPlayer2Flag"
                app:layout_constraintStart_toEndOf="@id/tvPlayer2Score"
                app:layout_constraintTop_toTopOf="@id/tvPlayer2Flag"
                tools:text="Michael van Gerwen" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Match Index Badge centered on top border line -->
    <TextView
        android:id="@+id/tvMatchRoundIndex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_match_index_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/cardMatch"
        app:layout_constraintEnd_toEndOf="@id/cardMatch"
        app:layout_constraintStart_toStartOf="@id/cardMatch"
        app:layout_constraintTop_toTopOf="@id/cardMatch"
        tools:text="Match #1" />

</androidx.constraintlayout.widget.ConstraintLayout>
