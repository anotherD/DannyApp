<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingTop="3dp"
    android:paddingBottom="0dp">

    <!-- Board Header (for qualifier tournaments) -->
    <LinearLayout
        android:id="@+id/layoutBoardHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvBoardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/rot_hell"
            android:textSize="@dimen/match_card_badge_size"
            android:textStyle="bold"
            tools:text="Board 1" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMatch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        style="@style/Widget.DannyApp.Card"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutBoardHeader">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/match_card_padding_h"
            android:paddingVertical="@dimen/match_card_padding_v">

            <!-- Player 1 -->
            <TextView
                android:id="@+id/tvPlayer1Name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/match_card_name_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvPlayer1Score"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Luke Humphries" />

            <!-- Score Center -->
            <TextView
                android:id="@+id/tvPlayer1Score"
                android:layout_width="@dimen/match_card_score_width"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/match_card_score_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvScoreDivider"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="6" />

            <TextView
                android:id="@+id/tvScoreDivider"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/match_card_divider_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvPlayer2Score"
                android:layout_width="@dimen/match_card_score_width"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/match_card_score_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvScoreDivider"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="4" />

            <!-- Player 2 -->
            <TextView
                android:id="@+id/tvPlayer2Name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="0dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/match_card_name_size"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvPlayer2Score"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Michael van Gerwen" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Match Index Badge centered vertically on top borderline of cardMatch -->
    <TextView
        android:id="@+id/tvMatchRoundIndex"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_match_index_badge"
        android:elevation="4dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="1dp"
        android:textColor="@color/grau_text_gedaempft"
        android:textSize="@dimen/match_card_badge_size"
        app:layout_constraintBottom_toTopOf="@id/cardMatch"
        app:layout_constraintEnd_toEndOf="@id/cardMatch"
        app:layout_constraintStart_toStartOf="@id/cardMatch"
        app:layout_constraintTop_toTopOf="@id/cardMatch"
        tools:text="Match #1" />

</androidx.constraintlayout.widget.ConstraintLayout>
