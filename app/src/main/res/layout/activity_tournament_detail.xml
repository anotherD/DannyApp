<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tournamentDetailMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.tournament.TournamentDetailActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_toolbar" />

    <ProgressBar
        android:id="@+id/pbLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- 1. GEMEINSAME KOPFKARTE (Preview, Active, Review) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardTournamentHeader"
        style="@style/Widget.DannyApp.Card.Hero"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/tour_hero_padding">

            <include layout="@layout/include_tournament_header_top" />

            <!-- A. Vorschau-Inhalt: tvPreviewPrizeFund -->
            <TextView
                android:id="@+id/tvPreviewPrizeFund"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/tour_hero_highlight_size"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderTypeBadge"
                tools:text="Gesamtpreisgeld: £1,000,000" />

            <!-- B. Aktiv-Inhalt: layoutActiveActions -->
            <LinearLayout
                android:id="@+id/layoutActiveActions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderTypeBadge">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSimulateCpuMatches"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_simulate_cpu"
                        android:textSize="@dimen/tour_hero_button_text_size" />

                    <Button
                        android:id="@+id/btnAdvanceRound"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="@string/btn_advance_round"
                        android:textSize="@dimen/tour_hero_button_text_size" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSimulateComplete"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/tournament_simulate_complete"
                    android:textSize="@dimen/tour_hero_button_text_size"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- C. Rückblick-Inhalt -->
            <TextView
                android:id="@+id/tvReviewWinnerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/tournament_review_winner_label"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/tour_hero_highlight_size"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderTypeBadge"
                tools:text="Sieger:" />

            <TextView
                android:id="@+id/tvReviewWinner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="?attr/colorPrimary"
                android:textSize="@dimen/tour_hero_highlight_size"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintBaseline_toBaselineOf="@id/tvReviewWinnerLabel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvReviewWinnerLabel"
                tools:text="Luke Humphries" />

            <TextView
                android:id="@+id/tvReviewQualifierHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/qualifier_winners_header"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/tour_hero_highlight_size"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderTypeBadge"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/layoutReviewQualifierWinnersList"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvReviewQualifierHeader"
                tools:visibility="visible" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierReviewBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="tvReviewWinner,layoutReviewQualifierWinnersList" />

            <TextView
                android:id="@+id/tvReviewUserRound"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/tour_hero_body_size"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/barrierReviewBottom"
                tools:text="Deine erreichte Runde: Viertelfinale" />

            <TextView
                android:id="@+id/tvReviewUserPrize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/tour_hero_body_size"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvReviewUserRound"
                tools:text="Gewonnenes Preisgeld: £35,000" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 2. GEMEINSAMER INHALTSBEREICH (Aktives & Abgeschlossenes Turnier) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTournamentContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardTournamentHeader"
        tools:visibility="visible">

        <!-- Round Selector Chips (Outside & directly below upper Card) -->
        <HorizontalScrollView
            android:id="@+id/scrollRoundPills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_spacing_tiny"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_margin"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupRounds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- Board Selector Chips (for Qualifiers) -->
        <HorizontalScrollView
            android:id="@+id/scrollBoardPills"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_spacing_tiny"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_margin"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollRoundPills"
            tools:visibility="visible">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupBoards"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- Group Selector Chips (for Grand Slam) -->
        <LinearLayout
            android:id="@+id/layoutGroupSelector"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_spacing_tiny"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/scrollBoardPills"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_selection_label"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/tour_group_label_size"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutGroupRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/item_spacing_tiny"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Group Standings Table Container (for Grand Slam List View) -->
        <FrameLayout
            android:id="@+id/containerGroupTable"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/screen_margin"
            android:layout_marginTop="@dimen/item_spacing_medium"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutGroupSelector"
            tools:visibility="visible" />

        <!-- Matches RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMatches"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/item_spacing_small"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingBottom="@dimen/list_bottom_padding_fab"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerGroupTable" />

        <!-- Tournament Bracket Custom View -->
        <com.danny.dannyapp.ui.tournament.TournamentBracketView
            android:id="@+id/bracketView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/item_spacing_small"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingBottom="@dimen/list_bottom_padding_fab"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/containerGroupTable"
            tools:visibility="gone" />

        <!-- Open Draw Info Container for UK Open / European Open -->
        <LinearLayout
            android:id="@+id/layoutOpenDrawInfo"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/item_spacing_small"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_margin"
            android:paddingTop="@dimen/list_screen_padding"
            android:paddingBottom="@dimen/list_bottom_padding_fab"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutGroupSelector"
            tools:visibility="gone">

            <TextView
                android:id="@+id/tvDrawAfterRoundInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="@dimen/list_screen_padding"
                android:text="@string/draw_after_round_info"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/tour_open_draw_info_size"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/list_bottom_padding_fab"
                android:scrollbars="vertical">

                <LinearLayout
                    android:id="@+id/layoutEntrantsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Start Button for Preview -->
    <Button
        android:id="@+id/btnStartTournamentPreview"
        style="@style/Widget.DannyApp.Button.PrimaryBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/tournament_start"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="gone" />

    <!-- Schwebe-Buttons unten rechts -->
    <LinearLayout
        android:id="@+id/layoutFabContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_fab_bar_margin_bottom"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabFocusUserMatch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/tour_fab_spacing"
            android:contentDescription="@string/cd_focus_user_match"
            android:src="@drawable/ic_my_location"
            app:fabCustomSize="@dimen/tour_fab_size"
            app:maxImageSize="@dimen/tour_fab_icon_size"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:tint="@color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabToggleBracketView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_show_bracket_view"
            android:src="@drawable/ic_bracket_tree"
            app:fabCustomSize="@dimen/tour_fab_size"
            app:maxImageSize="@dimen/tour_fab_icon_size"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Simulating Overlay -->
    <include
        android:id="@+id/layoutSimulatingOverlay"
        layout="@layout/include_loading_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
