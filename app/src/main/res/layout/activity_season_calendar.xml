<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/seasonCalendarMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.tournament.SeasonCalendarActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_toolbar" />

    <HorizontalScrollView
        android:id="@+id/scrollCalendarFilterChips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingHorizontal="0dp"
        android:paddingVertical="@dimen/oom_chip_group_pad_v"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCalendarFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/screen_margin"
            app:chipSpacingHorizontal="@dimen/oom_chip_spacing"
            app:singleLine="true"
            app:singleSelection="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterPc"
                style="@style/Widget.DannyApp.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/tournament_type_players_championship"
                app:chipBackgroundColor="@color/chip_bg_pc"
                app:chipStrokeColor="@color/chip_stroke_pc" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterEt"
                style="@style/Widget.DannyApp.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/tournament_type_european_tour"
                app:chipBackgroundColor="@color/chip_bg_et"
                app:chipStrokeColor="@color/chip_stroke_et" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFilterMajor"
                style="@style/Widget.DannyApp.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/tournament_type_major"
                app:chipBackgroundColor="@color/chip_bg_major"
                app:chipStrokeColor="@color/chip_stroke_major" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTournaments"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingTop="4dp"
        android:paddingBottom="@dimen/list_bottom_padding_fab"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollCalendarFilterChips"
        tools:listitem="@layout/item_tournament" />

    <TextView
        android:id="@+id/tvEmptyTournaments"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/list_empty_margin_h"
        android:text="@string/loading"
        android:textSize="@dimen/list_empty_text_size"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollCalendarFilterChips" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabFocusCurrentTournament"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/bottom_fab_bar_margin_bottom"
        android:contentDescription="@string/cd_focus_current_tournament"
        android:src="@drawable/ic_my_location"
        android:visibility="gone"
        app:fabSize="mini"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:tint="@color/white"
        tools:visibility="visible" />

    <!-- Simulating Overlay -->
    <include
        android:id="@+id/layoutCareerSimulatingOverlay"
        layout="@layout/include_loading_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
