<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.DannyApp.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/tournament_card_margin_bottom">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/tournament_card_padding">

        <TextView
            android:id="@+id/tvTournamentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="@dimen/tournament_card_title_size"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvTournamentStatus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="#1 Players Championship 1" />

        <TextView
            android:id="@+id/tvTournamentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_skill_badge"
            android:paddingHorizontal="@dimen/tournament_card_badge_pad_h"
            android:paddingVertical="@dimen/tournament_card_badge_pad_v"
            android:textColor="@color/white"
            android:textSize="@dimen/tournament_card_status_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Aktiv • Achtelfinale" />

        <TextView
            android:id="@+id/tvTournamentTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_major_badge"
            android:paddingHorizontal="@dimen/tournament_card_badge_pad_h"
            android:paddingVertical="@dimen/tournament_card_badge_pad_v"
            android:textColor="@color/white"
            android:textSize="@dimen/tournament_card_badge_size"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTournamentName"
            tools:text="Major" />

        <TextView
            android:id="@+id/tvTournamentDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="@dimen/tournament_card_details_size"
            app:layout_constraintEnd_toStartOf="@id/btnSimulateCompleteTournament"
            app:layout_goneMarginEnd="0dp"
            app:layout_constraintTop_toTopOf="@id/tvTournamentTypeBadge"
            app:layout_constraintBottom_toBottomOf="@id/tvTournamentTypeBadge"
            tools:text="🇩🇪 Hildesheim" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSimulateCompleteTournament"
            style="@style/Widget.Material3.Button.IconButton.Outlined"
            android:layout_width="@dimen/tournament_card_sim_btn_width"
            android:layout_height="@dimen/tournament_card_sim_btn_height"
            android:minWidth="0dp"
            android:minHeight="0dp"
            app:ensureMinTouchTargetSize="false"
            android:padding="@dimen/tournament_card_sim_icon_pad"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:visibility="gone"
            app:icon="@drawable/ic_fast_forward"
            app:iconSize="@dimen/tournament_card_sim_icon_size"
            app:iconPadding="0dp"
            app:iconTint="?attr/colorPrimary"
            app:iconGravity="textStart"
            android:contentDescription="@string/cd_simulate_up_to_here"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvTournamentTypeBadge"
            app:layout_constraintBottom_toBottomOf="@id/tvTournamentTypeBadge"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnStartTournament"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/start_button_min_height"
            android:paddingHorizontal="@dimen/tournament_card_start_btn_pad_h"
            android:layout_marginTop="@dimen/tournament_card_badge_pad_h"
            android:text="@string/tournament_start"
            android:textSize="@dimen/primary_bottom_button_text_size"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTournamentTypeBadge"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
