<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardBracketGroup"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginVertical="4dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="6dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/grau_rahmen_dunkel"
    app:cardBackgroundColor="@color/anthrazit_flaeche">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvBracketGroupLabel"
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:rotation="-90"
                android:maxLines="1"
                android:textSize="11sp"
                android:textColor="@color/grau_text_gedaempft"
                tools:text="Gruppe A" />
        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/grau_rahmen_dunkel" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp">

            <!-- Row 1 -->
            <LinearLayout
                android:id="@+id/rowGroupPlayer1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGroupRank1"
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    tools:text="1." />

                <TextView
                    android:id="@+id/tvGroupName1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Spieler 1" />

                <TextView
                    android:id="@+id/tvGroupPlayed1"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:gravity="end|center_vertical"
                    android:fontFeatureSettings="tnum"
                    tools:text="2" />

                <TextView
                    android:id="@+id/tvGroupDiff1"
                    android:layout_width="26dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:gravity="end|center_vertical"
                    android:fontFeatureSettings="tnum"
                    tools:text="+3" />

                <TextView
                    android:id="@+id/tvGroupPoints1"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:gravity="end|center_vertical"
                    android:fontFeatureSettings="tnum"
                    tools:text="4" />
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:id="@+id/rowGroupPlayer2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGroupRank2"
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    tools:text="2." />

                <TextView
                    android:id="@+id/tvGroupName2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Spieler 2" />

                <TextView
                    android:id="@+id/tvGroupPlayed2"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:gravity="end|center_vertical"
                    android:fontFeatureSettings="tnum"
                    tools:text="2" />

                <TextView
                    android:id="@+id/tvGroupDiff2"
                    android:layout_width="26dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:gravity="end|center_vertical"
                    android:fontFeatureSettings="tnum"
                    tools:text="+0" />

                <TextView
                    android:id="@+id/tvGroupPoints2"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:gravity="end|center_vertical"
                    android:fontFeatureSettings="tnum"
                    tools:text="2" />
            </LinearLayout>

            <!-- Row 3 -->
            <LinearLayout
                android:id="@+id/rowGroupPlayer3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGroupRank3"
                    android:layout_width="14dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    tools:text="3." />

                <TextView
                    android:id="@+id/tvGroupName3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="Spieler 3" />

                <TextView
                    android:id="@+id/tvGroupPlayed3"
                    android:layout_width="18dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:gravity="end|center_vertical"
                    android:fontFeatureSettings="tnum"
                    tools:text="2" />

                <TextView
                    android:id="@+id/tvGroupDiff3"
                    android:layout_width="26dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:gravity="end|center_vertical"
                    android:fontFeatureSettings="tnum"
                    tools:text="-13" />

                <TextView
                    android:id="@+id/tvGroupPoints3"
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:gravity="end|center_vertical"
                    android:fontFeatureSettings="tnum"
                    tools:text="0" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
