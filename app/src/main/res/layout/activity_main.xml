<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.MainActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_toolbar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/startLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_margin"
        android:paddingVertical="@dimen/list_screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <!-- Mehr Platz für die Bühne oben (~64%) -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guidelineTop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.64" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/heroPosterContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constrainedWidth="true"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@id/guidelineTop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Großes, freigestelltes Hero-Bild über fast die volle Breite -->
            <ImageView
                android:id="@+id/ivCardImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/start_image_margin_top"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/stage"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Show-Titel "Walk-On" -->
            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bowlby_one_sc"
                android:gravity="center"
                android:includeFontPadding="true"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:paddingVertical="8dp"
                android:rotation="-3"
                android:rotationX="15"
                android:rotationY="0"
                android:shadowColor="#CCFFB300"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="24"
                android:text="@string/app_name"
                android:textAllCaps="false"
                android:textColor="#FFFDF5"
                android:textSize="@dimen/start_title_text_size"
                app:layout_constraintEnd_toEndOf="@id/ivCardImage"
                app:layout_constraintStart_toStartOf="@id/ivCardImage"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Untertitel eingerahmt von zwei goldenen Linien -->
            <LinearLayout
                android:id="@+id/layoutSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:translationY="@dimen/start_subtitle_trans_y"
                app:layout_constraintBottom_toBottomOf="@id/ivCardImage"
                app:layout_constraintEnd_toEndOf="@id/ivCardImage"
                app:layout_constraintStart_toStartOf="@id/ivCardImage">

                <View
                    android:layout_width="@dimen/start_subtitle_line_width"
                    android:layout_height="@dimen/start_subtitle_line_height"
                    android:layout_marginEnd="10dp"
                    android:background="#80F5B041" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:letterSpacing="0.12"
                    android:shadowColor="#F0000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:text="@string/app_subtitle"
                    android:textAllCaps="true"
                    android:textColor="#F5B041"
                    android:textSize="@dimen/start_subtitle_text_size"
                    android:textStyle="bold" />

                <View
                    android:layout_width="@dimen/start_subtitle_line_width"
                    android:layout_height="@dimen/start_subtitle_line_height"
                    android:layout_marginStart="10dp"
                    android:background="#CCF5B041" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Bottom Button Area -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:paddingTop="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guidelineTop">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Button 1: Scolia Browser -->
                <Button
                    android:id="@+id/btnOpenScolia"
                    style="@style/Widget.DannyApp.Button.Start"
                    android:layout_height="wrap_content"
                    android:text="@string/scolia_browser" />

                <!-- Button 2: Profile -->
                <Button
                    android:id="@+id/btnProfiles"
                    style="@style/Widget.DannyApp.Button.Start"
                    android:layout_height="wrap_content"
                    android:text="@string/profiles" />

                <!-- Button 3: Karriere -->
                <Button
                    android:id="@+id/btnCareers"
                    style="@style/Widget.DannyApp.Button.Start"
                    android:layout_height="wrap_content"
                    android:text="@string/careers" />

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <WebView
        android:id="@+id/scoliaWebView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

</androidx.constraintlayout.widget.ConstraintLayout>
