<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/career_card_margin_bottom"
    app:cardCornerRadius="12dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/career_card_padding">

        <TextView
            android:id="@+id/tvCareerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="@dimen/career_card_title_size"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tvCareerSeason"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Karriere 1" />

        <TextView
            android:id="@+id/tvCareerSeason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/career_card_body_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Saison 1" />

        <TextView
            android:id="@+id/tvCareerPlayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/career_card_row_spacing"
            android:layout_marginEnd="8dp"
            android:textSize="@dimen/career_card_body_size"
            app:layout_constraintEnd_toStartOf="@+id/tvCareerLevel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCareerName"
            tools:text="🇩🇪 Spielername" />

        <TextView
            android:id="@+id/tvCareerProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/career_card_sub_spacing"
            android:layout_marginEnd="8dp"
            android:textSize="@dimen/career_card_body_size"
            app:layout_constraintEnd_toStartOf="@+id/tvCareerMatchDistance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCareerPlayer"
            tools:text="Profil: Pro" />

        <TextView
            android:id="@+id/tvCareerLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/career_card_row_spacing"
            android:textSize="@dimen/career_card_body_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCareerSeason"
            tools:text="Level 5" />

        <TextView
            android:id="@+id/tvCareerMatchDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/career_card_sub_spacing"
            android:textSize="@dimen/career_card_sub_size"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCareerLevel"
            tools:text="Kompakt (50 %)" />

        <TextView
            android:id="@+id/tvCareerCurrentTournament"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/career_card_sub_spacing"
            android:textSize="@dimen/career_card_sub_size"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCareerProfile"
            tools:text="Nächstes: Turniername (Runde 1)" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
