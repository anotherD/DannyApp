<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/crashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/anthrazit_hintergrund"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="@dimen/dialog_padding"
    tools:context=".ui.CrashActivity">

    <TextView
        android:id="@+id/tvCrashTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dialog_field_spacing"
        android:text="@string/crash_title"
        android:textColor="@color/rot_haupt"
        android:textSize="@dimen/crash_title_size"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCrashSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/overview_section_spacing"
        android:text="@string/crash_subtitle"
        android:textColor="@color/grau_text_hell"
        android:textSize="@dimen/crash_subtitle_size" />

    <LinearLayout
        android:id="@+id/layoutCrashErrorBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/overview_section_spacing"
        android:background="@color/anthrazit_container"
        android:orientation="vertical"
        android:padding="@dimen/crash_box_padding">

        <TextView
            android:id="@+id/tvCrashErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/grau_text_hell"
            android:textSize="@dimen/crash_message_size"
            android:textStyle="bold"
            tools:text="Unbekannter Fehler" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollCrashStacktrace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/overview_section_spacing"
        android:layout_weight="1"
        android:background="@color/anthrazit_tief"
        android:padding="@dimen/dialog_padding">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tvCrashStacktrace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/grau_text_gedaempft"
                android:textSize="@dimen/crash_stacktrace_size"
                tools:text="java.lang.RuntimeException: Unerwarteter Fehler" />
        </HorizontalScrollView>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnCrashCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/dialog_field_spacing"
            android:background="@color/anthrazit_container_hoch"
            android:text="@string/crash_copy_button"
            android:textColor="@color/grau_text_hell" />

        <Button
            android:id="@+id/btnCrashRestart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/rot_haupt"
            android:text="@string/crash_restart_button"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
