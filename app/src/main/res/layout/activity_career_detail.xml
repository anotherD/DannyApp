<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/careerDetailMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.career.CareerDetailActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollCareerOverview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:id="@+id/layoutCareerOverviewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/overview_padding_horizontal"
            android:paddingVertical="@dimen/overview_padding">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/overview_section_spacing"
                style="@style/Widget.DannyApp.Card.Variant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/overview_padding">

                    <TextView
                        android:id="@+id/tvCareerOverviewPlayer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/overview_player_text_size"
                        android:textStyle="bold"
                        tools:text="🇩🇪 Max Mustermann" />

                    <TextView
                        android:id="@+id/tvCareerOverviewMeta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="@dimen/overview_meta_text_size"
                        tools:text="Profil: Pro Player • Saison 1 • Level 5" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/overview_section_spacing">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardOverviewRankings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    style="@style/Widget.DannyApp.Card"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/cardShortcutCalendar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/overview_padding">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <LinearLayout
                                android:id="@+id/layoutOverviewRankOom"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/oom_tab_oom"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="@dimen/overview_ranking_label_size" />

                                <TextView
                                    android:id="@+id/tvOverviewRankOom"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="@dimen/overview_ranking_value_size"
                                    android:textStyle="bold"
                                    tools:text="#12 (£45,000)" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutOverviewRankPt"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/oom_tab_pt"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="@dimen/overview_ranking_label_size" />

                                <TextView
                                    android:id="@+id/tvOverviewRankPt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="@dimen/overview_ranking_value_size"
                                    android:textStyle="bold"
                                    tools:text="#18 (£15,000)" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:baselineAligned="false"
                            android:gravity="center_horizontal"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <LinearLayout
                                android:id="@+id/layoutOverviewRankPc"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/oom_tab_pc"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="@dimen/overview_ranking_label_size" />

                                <TextView
                                    android:id="@+id/tvOverviewRankPc"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="@dimen/overview_ranking_value_size"
                                    android:textStyle="bold"
                                    tools:text="#15 (£10,000)" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layoutOverviewRankEt"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center_horizontal"
                                android:orientation="vertical"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="8dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/oom_tab_et"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="@dimen/overview_ranking_label_size" />

                                <TextView
                                    android:id="@+id/tvOverviewRankEt"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="@dimen/overview_ranking_value_size"
                                    android:textStyle="bold"
                                    tools:text="#24 (£5,000)" />
                            </LinearLayout>
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardShortcutCalendar"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginBottom="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    style="@style/Widget.DannyApp.Card"
                    app:layout_constraintBottom_toTopOf="@id/cardShortcutStats"
                    app:layout_constraintDimensionRatio="W,1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/cardOverviewRankings">

                    <ImageView
                        android:layout_width="@dimen/overview_shortcut_icon_size"
                        android:layout_height="@dimen/overview_shortcut_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_open_season_calendar"
                        android:src="@drawable/ic_calendar"
                        app:tint="?attr/colorOnSurface" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardShortcutStats"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    style="@style/Widget.DannyApp.Card"
                    app:layout_constraintBottom_toBottomOf="@id/cardOverviewRankings"
                    app:layout_constraintDimensionRatio="W,1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cardShortcutCalendar">

                    <ImageView
                        android:layout_width="@dimen/overview_shortcut_icon_size"
                        android:layout_height="@dimen/overview_shortcut_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@string/cd_open_statistics"
                        android:src="@drawable/ic_stats"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/current_or_next_tournament"
                android:textSize="@dimen/overview_section_header_size"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/containerActiveTournament"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/tvNoActiveTournament"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/no_active_or_next_tournament"
                android:textAlignment="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="@dimen/overview_empty_text_size"
                android:visibility="gone"
                tools:visibility="visible" />

            <Button
                android:id="@+id/btnEndSeason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_end_season"
                android:textSize="@dimen/overview_empty_text_size"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Simulating Overlay -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCareerSimulatingOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <TextView
                android:id="@+id/tvCareerSimulationProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Simuliere Turnier 1/5:\nPlayers Championship 1" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
