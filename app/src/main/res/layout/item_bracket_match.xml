<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardBracketMatch"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:layout_marginVertical="4dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="6dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/grau_rahmen_dunkel"
    app:cardBackgroundColor="@color/anthrazit_flaeche">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvBracketMatchIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:rotation="-90"
                android:maxLines="1"
                android:textColor="@color/grau_text_gedaempft"
                android:textSize="10sp"
                tools:text="#1" />
        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/grau_rahmen_dunkel" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <!-- Row 1: Player 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlayer1Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/grau_text_hell"
                    android:textSize="13sp"
                    tools:text="M.van Gerwen" />

                <TextView
                    android:id="@+id/tvPlayer1Score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/grau_text_hell"
                    android:textSize="13sp"
                    tools:text="6" />
            </LinearLayout>

            <!-- Divider line -->
            <View
                android:id="@+id/dividerBracketMatch"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/grau_rahmen_dunkel" />

            <!-- Row 2: Player 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPlayer2Name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/grau_text_hell"
                    android:textSize="13sp"
                    tools:text="L.Littler" />

                <TextView
                    android:id="@+id/tvPlayer2Score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="@color/grau_text_hell"
                    android:textSize="13sp"
                    tools:text="4" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
