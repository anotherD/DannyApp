<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/configurationMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.settings.SettingsActivity">

    <include
        android:id="@+id/toolbar"
        layout="@layout/include_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/settings_padding">

            <!-- Section 1: Gameplay & Simulation -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/settings_section_header_margin"
                android:text="@string/settings_section_gameplay"
                android:textColor="@color/rot_hell"
                android:textSize="@dimen/settings_section_header_size"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/settings_card_margin_bottom"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/settings_padding">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoSimulateCpu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/config_auto_simulate_cpu"
                        android:textSize="@dimen/settings_item_text_size" />

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/settings_divider_margin_v" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutoAdvanceRound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/config_auto_advance_round"
                        android:textSize="@dimen/settings_item_text_size" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 2: Design -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/settings_section_header_margin"
                android:text="@string/settings_section_design"
                android:textColor="@color/rot_hell"
                android:textSize="@dimen/settings_section_header_size"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/settings_card_margin_bottom"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/settings_padding">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchModernMatchCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_modern_match_card"
                        android:textSize="@dimen/settings_item_text_size" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: Entwickler -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/settings_section_header_margin"
                android:text="@string/settings_section_developer"
                android:textColor="@color/rot_hell"
                android:textSize="@dimen/settings_section_header_size"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/settings_card_margin_bottom"
                app:cardCornerRadius="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/settings_padding">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDebugMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/config_debug_mode"
                        android:textSize="@dimen/settings_item_text_size" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Players Management Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPlayers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/settings_card_margin_bottom"
                app:cardCornerRadius="12dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/settings_padding"
                    android:gravity="center_vertical"
                    android:text="@string/config_players"
                    android:textSize="@dimen/settings_item_text_size"
                    android:textStyle="bold"
                    app:drawableEndCompat="@drawable/ic_arrow_forward" />
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
