<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.oom.OrderOfMeritContainerFragment">

    <HorizontalScrollView
        android:id="@+id/scrollOomChips"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/oom_chip_group_pad_h"
        android:paddingVertical="@dimen/oom_chip_group_pad_v"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupOomTypes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="@dimen/oom_chip_spacing"
            app:singleSelection="true"
            app:selectionRequired="true"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOomMain"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/oom_chip_min_height"
                android:textSize="@dimen/oom_chip_text_size"
                android:checked="true"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/anthrazit_container_niedrig"
                app:chipStrokeWidth="@dimen/card_stroke_thin"
                android:text="@string/oom_tab_oom" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOomProTour"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/oom_chip_min_height"
                android:textSize="@dimen/oom_chip_text_size"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/anthrazit_container_niedrig"
                app:chipStrokeWidth="@dimen/card_stroke_thin"
                android:text="@string/oom_tab_pt" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOomPlayersChamp"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/oom_chip_min_height"
                android:textSize="@dimen/oom_chip_text_size"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/anthrazit_container_niedrig"
                app:chipStrokeWidth="@dimen/card_stroke_thin"
                android:text="@string/oom_tab_pc" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipOomEuropeanTour"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/oom_chip_min_height"
                android:textSize="@dimen/oom_chip_text_size"
                app:checkedIconVisible="false"
                app:chipBackgroundColor="@color/anthrazit_container_niedrig"
                app:chipStrokeWidth="@dimen/card_stroke_thin"
                android:text="@string/oom_tab_et" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerOom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/scrollOomChips" />

</androidx.constraintlayout.widget.ConstraintLayout>
