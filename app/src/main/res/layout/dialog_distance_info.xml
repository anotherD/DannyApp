<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvDistanceInfoDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/info_dialog_padding_h"
        android:paddingVertical="@dimen/info_dialog_padding_v"
        android:text="@string/match_distance_info_description"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="@dimen/info_dialog_body_size" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutDistancePresets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabMode="scrollable" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerDistancePresets"
        android:layout_width="match_parent"
        android:layout_height="@dimen/info_dialog_pager_height"
        android:layout_marginTop="8dp" />

</LinearLayout>
