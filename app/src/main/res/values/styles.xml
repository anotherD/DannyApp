<resources>
    <!-- Zentrales Basis-Theme mit allen Farben (Single Source of Truth) -->
    <style name="Base.Theme.DannyApp" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Fenster-Startfarbe (verhindert weißes Aufblitzen beim Start) -->
        <item name="android:windowBackground">@color/anthrazit_hintergrund</item>

        <!-- Abwärtskompatible Systemleisten für ältere Android-Versionen (z. B. Android 9) -->
        <item name="android:statusBarColor">@color/anthrazit_hintergrund</item>
        <item name="android:navigationBarColor">@color/anthrazit_tief</item>

        <!-- Hauptfarbe (Rot) für Buttons, aktive Schalter, Ladebalken -->
        <item name="colorPrimary">@color/rot_haupt</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/rot_dunkel</item>
        <item name="colorOnPrimaryContainer">@color/rot_sehr_hell</item>

        <!-- Zweitfarbe (Reines Neutralgrau / Anthrazit) für sekundäre Elemente & Menü-Pills -->
        <item name="colorSecondary">@color/grau_sekundaer</item>
        <item name="colorOnSecondary">@color/anthrazit_container_niedrig</item>
        <item name="colorSecondaryContainer">@color/anthrazit_sekundaer</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Drittfarbe (Akzente in hellem Rot) -->
        <item name="colorTertiary">@color/rot_hell</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/rot_container_dunkel</item>
        <item name="colorOnTertiaryContainer">@color/rot_sehr_hell</item>

        <!-- Hintergrund & Flächen (Anthrazit) -->
        <item name="android:colorBackground">@color/anthrazit_hintergrund</item>
        <item name="colorOnBackground">@color/grau_text_hell</item>
        <item name="colorSurface">@color/anthrazit_flaeche</item>
        <item name="colorOnSurface">@color/grau_text_hell</item>
        <item name="colorSurfaceVariant">@color/anthrazit_variante</item>
        <item name="colorOnSurfaceVariant">@color/grau_text_gedaempft</item>

        <!-- Container-Abstufungen für Karten, Dialoge, Menüs & Leisten -->
        <item name="colorSurfaceContainerLowest">@color/anthrazit_tief</item>
        <item name="colorSurfaceContainerLow">@color/anthrazit_container_niedrig</item>
        <item name="colorSurfaceContainer">@color/anthrazit_container</item>
        <item name="colorSurfaceContainerHigh">@color/anthrazit_container_hoch</item>
        <item name="colorSurfaceContainerHighest">@color/anthrazit_container_hoechst</item>

        <!-- Rahmenlinien & Trennstriche -->
        <item name="colorOutline">@color/grau_rahmen</item>
        <item name="colorOutlineVariant">@color/grau_rahmen_dunkel</item>
        <item name="android:fadingEdgeLength">@dimen/fading_edge_length</item>



        <!-- verhindert, dass cards mit elevation eingefärbt werden mit colorPrimary -->
<!--        <item name="elevationOverlayEnabled">false</item>-->

        <!-- FEHLER -->
<!--        <item name="colorError">@color/rot_hell</item>-->
<!--        <item name="colorOnError">@color/black</item>-->
<!--        <item name="colorErrorContainer">@color/rot_dunkel</item>-->
<!--        <item name="colorOnErrorContainer">@color/white</item>&ndash;&gt;-->
    </style>

    <!-- Splash-Screen-Theme beim App-Start -->
<!--    <style name="Theme.DannyApp.Splash" parent="Theme.SplashScreen">-->
<!--        <item name="windowSplashScreenBackground">#121212</item>-->
<!--        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash_walkon</item>-->
<!--        <item name="windowSplashScreenAnimationDuration">750</item>-->
<!--        <item name="postSplashScreenTheme">@style/Theme.DannyApp</item>-->
<!--    </style>-->
    <style name="Theme.DannyApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#121212</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_walkon_icon</item>
        <item name="windowSplashScreenAnimationDuration">11750</item>
        <item name="postSplashScreenTheme">@style/Theme.DannyApp</item>
    </style>
    <style name="Widget.DannyApp.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeWidth">@dimen/dialog_box_stroke_width</item>
        <item name="boxStrokeWidthFocused">@dimen/dialog_box_stroke_width_focused</item>
        <item name="hintTextAppearance">@style/TextAppearance.DannyApp.TextInputHint</item>
        <item name="android:textColorHint">@color/eingabe_hint</item>
    </style>

    <style name="Widget.DannyApp.TextInputLayout.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxStrokeWidth">@dimen/dialog_box_stroke_width</item>
        <item name="boxStrokeWidthFocused">@dimen/dialog_box_stroke_width_focused</item>
        <item name="hintTextAppearance">@style/TextAppearance.DannyApp.TextInputHint</item>
        <item name="android:textColorHint">@color/eingabe_hint</item>
    </style>

    <style name="TextAppearance.DannyApp.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/toolbar_title_size</item>
    </style>

    <style name="TextAppearance.DannyApp.ToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/toolbar_subtitle_size</item>
        <item name="android:textColor">@color/grau_text_gedaempft</item>
    </style>

    <style name="TextAppearance.DannyApp.DialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">@dimen/dialog_title_size</item>
    </style>

    <style name="TextAppearance.DannyApp.DialogBody" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textSize">@dimen/dialog_message_text_size</item>
    </style>

    <style name="TextAppearance.DannyApp.DialogButton" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">@dimen/dialog_button_text_size</item>
    </style>

    <style name="Widget.DannyApp.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAppearance">@style/TextAppearance.DannyApp.DialogButton</item>
        <item name="android:textSize">@dimen/dialog_button_text_size</item>
        <item name="android:minHeight">@dimen/start_button_min_height</item>
        <item name="android:paddingHorizontal">@dimen/dialog_button_pad_h</item>
        <item name="android:paddingVertical">@dimen/dialog_button_pad_v</item>
    </style>

    <style name="TextAppearance.DannyApp.TextInputHint" parent="TextAppearance.Design.Hint">
        <item name="android:textSize">@dimen/dialog_input_hint_size</item>
    </style>

    <style name="ThemeOverlay.DannyApp.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/TextAppearance.DannyApp.DialogTitle</item>
        <item name="materialAlertDialogBodyTextStyle">@style/TextAppearance.DannyApp.DialogBody</item>
        <item name="buttonBarButtonStyle">@style/Widget.DannyApp.DialogButton</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.DannyApp.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.DannyApp.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.DannyApp.DialogButton</item>
    </style>

    <style name="Widget.DannyApp.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_corner_radius</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/card_stroke_thin</item>
    </style>

    <style name="Widget.DannyApp.Card.Variant" parent="Widget.DannyApp.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.DannyApp.Card.Compact" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_corner_radius_small</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="strokeWidth">@dimen/card_stroke_thin</item>
    </style>

    <style name="Widget.DannyApp.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">@dimen/oom_chip_min_height</item>
        <item name="android:textSize">@dimen/oom_chip_text_size</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">@dimen/card_stroke_thin</item>
    </style>

    <style name="Widget.DannyApp.Chip.Control" parent="Widget.Material3.Chip.Filter">
        <item name="android:minHeight">@dimen/tour_control_chip_min_height</item>
        <item name="android:textSize">@dimen/tour_control_chip_text_size</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <style name="Widget.DannyApp.Button.Sort" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:paddingHorizontal">@dimen/players_sort_button_pad_h</item>
        <item name="android:paddingVertical">@dimen/players_sort_button_pad_v</item>
        <item name="android:minHeight">@dimen/players_sort_button_min_height</item>
        <item name="strokeWidth">@dimen/card_stroke_thin</item>
        <item name="android:textSize">@dimen/players_sort_button_text_size</item>
    </style>

    <style name="Widget.DannyApp.Card.StickyUser" parent="Widget.DannyApp.Card.Compact">
        <item name="cardBackgroundColor">@color/rot_container_dunkel</item>
        <item name="cardCornerRadius">@dimen/card_corner_radius_sticky</item>
        <item name="cardElevation">@dimen/sticky_card_elevation</item>
        <item name="android:translationZ">@dimen/sticky_card_elevation</item>
        <item name="android:outlineSpotShadowColor">@color/black</item>
        <item name="android:outlineAmbientShadowColor">@color/black</item>
        <item name="strokeColor">@color/rot_haupt</item>
        <item name="strokeWidth">@dimen/card_stroke_thick</item>
    </style>
</resources>
