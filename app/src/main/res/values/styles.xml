<resources>
    <!-- Zentrales Basis-Theme mit allen Farben (Single Source of Truth) -->
    <style name="Base.Theme.DannyApp" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Fenster-Startfarbe (verhindert weißes Aufblitzen beim Start) -->
        <item name="android:windowBackground">@color/anthrazit_hintergrund</item>

        <!-- Abwärtskompatible Systemleisten für ältere Android-Versionen (z. B. Android 9) -->
        <item name="android:statusBarColor">@color/anthrazit_hintergrund</item>
        <item name="android:navigationBarColor">@color/anthrazit_tief</item>

        <!-- Hauptfarbe (Rot) für Buttons, aktive Schalter, Ladebalken -->
        <item name="colorPrimary">@color/rot_haupt</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/rot_dunkel</item>
        <item name="colorOnPrimaryContainer">@color/rot_sehr_hell</item>

        <!-- Zweitfarbe (Reines Neutralgrau / Anthrazit) für sekundäre Elemente & Menü-Pills -->
        <item name="colorSecondary">@color/grau_sekundaer</item>
        <item name="colorOnSecondary">@color/anthrazit_container_niedrig</item>
        <item name="colorSecondaryContainer">@color/anthrazit_sekundaer</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Drittfarbe (Akzente in hellem Rot) -->
        <item name="colorTertiary">@color/rot_hell</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/rot_container_dunkel</item>
        <item name="colorOnTertiaryContainer">@color/rot_sehr_hell</item>

        <!-- Hintergrund & Flächen (Anthrazit) -->
        <item name="android:colorBackground">@color/anthrazit_hintergrund</item>
        <item name="colorOnBackground">@color/grau_text_hell</item>
        <item name="colorSurface">@color/anthrazit_flaeche</item>
        <item name="colorOnSurface">@color/grau_text_hell</item>
        <item name="colorSurfaceVariant">@color/anthrazit_variante</item>
        <item name="colorOnSurfaceVariant">@color/grau_text_gedaempft</item>

        <!-- Container-Abstufungen für Karten, Dialoge, Menüs & Leisten -->
        <item name="colorSurfaceContainerLowest">@color/anthrazit_tief</item>
        <item name="colorSurfaceContainerLow">@color/anthrazit_container_niedrig</item>
        <item name="colorSurfaceContainer">@color/anthrazit_container</item>
        <item name="colorSurfaceContainerHigh">@color/anthrazit_container_hoch</item>
        <item name="colorSurfaceContainerHighest">@color/anthrazit_container_hoechst</item>

        <!-- Rahmenlinien & Trennstriche -->
        <item name="colorOutline">@color/grau_rahmen</item>
        <item name="colorOutlineVariant">@color/grau_rahmen_dunkel</item>

        <!-- Globaler Stil für TextInputLayout (setzt Hint-Farbe nur im leeren Zustand) -->
        <item name="textInputStyle">@style/Widget.DannyApp.TextInputLayout.OutlinedBox</item>

        <!-- verhindert, dass cards mit elevation eingefärbt werden mit colorPrimary -->
<!--        <item name="elevationOverlayEnabled">false</item>-->

        <!-- FEHLER -->
<!--        <item name="colorError">@color/rot_hell</item>-->
<!--        <item name="colorOnError">@color/black</item>-->
<!--        <item name="colorErrorContainer">@color/rot_dunkel</item>-->
<!--        <item name="colorOnErrorContainer">@color/white</item>-->
    </style>

    <!-- Eigener TextInputLayout-Stil für den Platzhalter (Hint) ohne den schwebenden Label zu beeinflussen -->
    <style name="Widget.DannyApp.TextInputLayout.OutlinedBox" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="android:textColorHint">@color/eingabe_hint</item>
    </style>
</resources>
